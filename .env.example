# Development configuration. Replace values; do not commit real credentials.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Database=Host=127.0.0.1;Port=5432;Database=kosova;Username=kosova;Password=replace-with-local-password
DemoMode=true
DemoPassword=replace-with-a-long-local-password
TestPaymentSecret=replace-with-random-test-webhook-secret
WebOrigin=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:5080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
PrivateStorage=/data/private-documents
DataProtection__Path=/data/keys
RetentionDays=180

# Production only: DemoMode=false; ASPNETCORE_ENVIRONMENT=Production.
# Hosted test API: RuntimeMode=HostedTest; WebOrigin=https://your-vercel-domain; Supabase__Url=https://your-project.supabase.co;
# Supabase__PublishableKey=public-publishable-key; ConnectionStrings__Database=private-pooler-connection-string.
# Apply SQL migrations out-of-band before starting; the API runtime DB role needs DML and BYPASSRLS but no DDL.
# Must use an empty production database, HTTPS and approved policies.
# TermsVersion=approved-version-id
# Oidc__Authority=https://your-identity-provider
# Oidc__ClientId=
# Oidc__ClientSecret=
# Oidc__MfaClaim=amr
# Oidc__MfaValue=mfa
# Storage__Region=
# Storage__Bucket=
# AWS credentials use the standard credential chain / workload identity.
# Scanner__Host=
# Scanner__Port=3310
# Email__Host=
# Email__Port=587
# Email__From=
# Email__Username=
# Email__Password=
# DataProtection__CertificatePath=/run/secrets/dataprotection.pfx
# DataProtection__CertificatePassword=
# BootstrapAdminSubject=exact-oidc-subject
# BootstrapAdminEmail=your-admin-address
